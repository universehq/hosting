<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <PublishAot>true</PublishAot>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Hosting.HostFxr/Universe.Hosting.HostFxr.csproj" />
    <ProjectReference Include="../../src/Hosting.NetHost/Universe.Hosting.NetHost.csproj" />
  </ItemGroup>
  <Target
    Name="AngelaNormalizeNativeAotToolPaths"
    BeforeTargets="LinkNative"
    DependsOnTargets="SetupOSSpecificProps"
    Condition="'$(PublishAot)' == 'true' and '$(IlcUseEnvironmentalTools)' != 'true'"
  >
    <PropertyGroup>
      <_AngelaCppLinkerCandidate>$(CppLinker.Substring($([MSBuild]::Add($(CppLinker.LastIndexOf(';')), 1))).Trim())</_AngelaCppLinkerCandidate>
      <_AngelaCppLibCreatorCandidate>$(CppLibCreator.Substring($([MSBuild]::Add($(CppLibCreator.LastIndexOf(';')), 1))).Trim())</_AngelaCppLibCreatorCandidate>
    </PropertyGroup>
    <PropertyGroup>
      <CppLinker Condition="!Exists('$(CppLinker)') and Exists('$(_AngelaCppLinkerCandidate)')"
        >$(_AngelaCppLinkerCandidate)</CppLinker>
      <CppLibCreator
        Condition="!Exists('$(CppLibCreator)') and Exists('$(_AngelaCppLibCreatorCandidate)')"
        >$(_AngelaCppLibCreatorCandidate)</CppLibCreator>
    </PropertyGroup>
  </Target>
</Project>
